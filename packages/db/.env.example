# Supabase Postgres connection strings.
#
# Get the host from Supabase dashboard → Project Settings → Database. The direct
# host (db.<ref>.supabase.co) is IPv6-only on new projects — if your network has
# no IPv6 route, use the SESSION pooler (:5432) for DIRECT_DATABASE_URL. The
# transaction pooler (:6543) cannot run migrations.
#
# TLS: Supabase signs its Postgres certs with its own CA, which is not in the
# system trust store, so `sslmode=require` fails to verify the chain. These
# default to `sslmode=no-verify` — encrypted, but NOT protected against an
# active MITM. Before this touches production data, download the project CA
# (Dashboard → Project Settings → Database → SSL Configuration) to
# packages/db/certs/, then switch every URL below to:
#   ?sslmode=verify-full&sslrootcert=./certs/prod-ca-2021.crt

# --- migrations (prisma migrate / db pull) ---
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- runtime, owner role: admin scripts and migrations only ---
DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# --- runtime, RLS-enforced: the apps/api request path (see withUser()) ---
APP_USER_DATABASE_URL="postgresql://app_user.<ref>:<app-user-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# --- runtime, BYPASSRLS: queue worker and purge job only ---
APP_SERVICE_DATABASE_URL="postgresql://app_service.<ref>:<app-service-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
