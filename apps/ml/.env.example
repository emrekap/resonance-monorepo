# ── TRIBE v2 API – Environment variables ─────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── HuggingFace ──────────────────────────────────────────────────────────────
# REQUIRED for all inference (video, audio, and text): TRIBE v2's text encoder
# is the gated meta-llama/Llama-3.2-3B repo, so every request loads it.
#   1. Request access: https://huggingface.co/meta-llama/Llama-3.2-3B
#   2. Create a token:  https://huggingface.co/settings/tokens
# huggingface_hub reads HF_TOKEN; main.py also accepts the HUGGINGFACE_TOKEN
# and HUGGING_FACE_HUB_TOKEN aliases.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── Model cache ──────────────────────────────────────────────────────────────
# Where to store the downloaded TRIBE v2 weights (~1 GB on first run).
TRIBE_CACHE_DIR=./cache

# ── Server (main.py — the FastAPI face, what the HF Space serves) ────────────
HOST=0.0.0.0
PORT=8000

# ── Queue worker (worker.py — what apps/api actually drives) ─────────────────
# Same Redis as apps/api and apps/worker. Local: infra/docker/docker-compose.yml
REDIS_URL=redis://127.0.0.1:6379

# Jobs in flight. This is GPU memory, not I/O — two TRIBE runs on one card is
# how you OOM halfway through both. Raise only with headroom to spare.
# ML_WORKER_CONCURRENCY=1

# How long BullMQ holds the job lock, in ms. Must exceed the slowest run, or
# the stalled-job checker hands the same clip to a second worker mid-inference.
# ML_WORKER_LOCK_MS=1800000

# Refuse media larger than this (bytes) instead of filling the disk. Default 2 GB.
# ML_MAX_MEDIA_BYTES=2147483648
# ML_DOWNLOAD_TIMEOUT_S=300

# ── Device override ──────────────────────────────────────────────────────────
# Auto-detects cuda > mps > cpu. Force it with cpu | cuda | mps.
# TRIBE_DEVICE=cuda
