# Supabase — auth only. The publishable (anon) key is safe to ship in the app;
# RLS and the API's JWT check are what protect data. Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# The Bun API (apps/api). On a device, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
