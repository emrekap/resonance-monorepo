# Resonance API (Bun + Hono)
PORT=3000

# --- Queue -----------------------------------------------------------------
# Where POST /analyze publishes its job. The apps/ml worker consumes it; this
# process only ever produces. Local Redis: infra/docker/docker-compose.yml
REDIS_URL=redis://127.0.0.1:6379

# URL of the Python ML inference service (apps/ml). Only its FastAPI face —
# nothing on the request path calls it, since analysis goes over the queue.
ML_SERVICE_URL=http://localhost:8000

# --- Supabase auth ---------------------------------------------------------
# Access tokens are signed with an asymmetric key (ES256); the API verifies them
# locally against the project's published JWKS, so there is no GoTrue round trip
# per request and NO secret is needed here. SUPABASE_JWKS_URL is optional — it
# defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Database (see packages/db/.env.example) -------------------------------
# The request path ONLY. This is the `app_user` role: no BYPASSRLS, does not own
# the tables, so RLS binds to it. Do NOT put APP_SERVICE_DATABASE_URL here — the
# BYPASSRLS credential belongs to the queue worker, not to a process that serves
# requests. `@repo/db` connects lazily, so this process never needs it.
APP_USER_DATABASE_URL="postgresql://app_user.<ref>:<app-user-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
